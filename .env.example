# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────────
# Públicas (expuestas al navegador):
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Solo servidor — NUNCA exponer al cliente ni prefijar con NEXT_PUBLIC_:
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─────────────────────────────────────────────────────────────────────────────
# Notificaciones (n8n)
# Webhook que gestiona email + WhatsApp. Solo se invoca desde el servidor.
# ─────────────────────────────────────────────────────────────────────────────
N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/nexus-leads

# Secreto compartido de las rutas cron (/api/cron/*). Solo servidor.
#   · Vercel Cron (keep-alive, cumpleanos) lo manda solo como
#     `Authorization: Bearer $CRON_SECRET` en cuanto la variable existe.
#   · n8n (recordatorio-clase) lo manda como header `x-cron-secret`.
# `cronRequestIsAuthorized` acepta las dos formas.
CRON_SECRET=your-cron-secret

# ─────────────────────────────────────────────────────────────────────────────
# Marca / contacto
# Teléfono de WhatsApp en formato internacional sin '+' ni espacios (ej: 34600000000)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=34600000000

# URL canónica del sitio (para metadata, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://nexusvng.es

# ─────────────────────────────────────────────────────────────────────────────
# Analítica — Google Analytics 4
# ID de medición del data stream (G-XXXXXXXXXX). Si se deja vacío no se carga
# ni GA4 ni el banner de cookies: útil en local y en previews.
# Arranca con Consent Mode v2 denegado hasta que el visitante acepta.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Reseñas de Google (bloque "Dónde estamos" de la home), vía Featurable
# El ID del widget es público y está en src/lib/site.ts. La API hoy responde
# sin clave; si algún día la pide, se crea en featurable.com y va aquí.
# Solo servidor: nunca con NEXT_PUBLIC_. Opcional.
# ─────────────────────────────────────────────────────────────────────────────
FEATURABLE_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Mapa de la sala (home y /contacto), vía MapTiler
# Clave PÚBLICA (va al navegador): en maptiler.com, restringirla por "Allowed
# HTTP origins" a nexusvng.es, www.nexusvng.es, los *.vercel.app del proyecto y
# localhost. Vacía = se enseña la fachada de dos clics de Google Maps.
# Se inlinea al compilar: tras cambiarla en Vercel hay que redesplegar.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPTILER_KEY=
